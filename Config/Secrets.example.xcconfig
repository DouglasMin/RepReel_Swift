// Copy to Config/Secrets.xcconfig (gitignored) and fill in.
// Then re-run `make generate` so Xcode picks the values up.

APP_BUNDLE_ID = com.yourname.reelsworkout
APP_GROUP_ID = group.com.yourname.reelsworkout

// Host only, no https:// prefix.
API_HOST = abc123xyz.execute-api.ap-northeast-2.amazonaws.com
API_STAGE_PATH = /dev

// Must match APP_SECRET_KEY on the backend.
APP_SECRET = your-private-app-secret-token

// Must be present in the backend's ALLOWED_USER_EMAILS whitelist.
DEV_USER_EMAIL = you@example.com

// Apple Developer team id, required only for device builds.
DEVELOPMENT_TEAM =
